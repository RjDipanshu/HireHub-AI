# =============================================================================
# HireHub AI — Production Environment Variables
# Copy to .env.production on your production server
# =============================================================================

# Server Environment
NODE_ENV=production
SPRING_PROFILES_ACTIVE=prod

# Production Domain & CORS Origins
CORS_ALLOWED_ORIGINS=https://hirehub.ai,https://www.hirehub.ai

# Frontend Client Public Variables
VITE_SUPABASE_URL=https://qbdcvnkomdzqfxevlhhj.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
VITE_API_BASE_URL=/api/v1

# Backend Supabase PostgreSQL Connection
SPRING_DATASOURCE_URL=jdbc:postgresql://db.qbdcvnkomdzqfxevlhhj.supabase.co:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_production_database_password_here

# Backend Supabase JWT Authentication
SUPABASE_JWT_ISSUER=https://qbdcvnkomdzqfxevlhhj.supabase.co/auth/v1
SUPABASE_JWK_SET_URI=https://qbdcvnkomdzqfxevlhhj.supabase.co/auth/v1/.well-known/jwks.json

# Google Gemini AI Production Key
GEMINI_API_KEY=your_google_gemini_api_key_here

# Frontend Application Public URL (used in transactional emails, e.g. ticket links)
APP_FRONTEND_URL=https://hirehub.ai

# Support and Sender Email Configuration
MAIL_FROM=supporthirehub.ai@gmail.com
SUPPORT_EMAIL=supporthirehub.ai@gmail.com

# Optional: Transactional Email SMTP (e.g., SendGrid, AWS SES, Gmail, Resend)
SPRING_MAIL_HOST=smtp.sendgrid.net
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=apikey
SPRING_MAIL_PASSWORD=your_sendgrid_or_resend_api_key
SPRING_MAIL_AUTH=true
SPRING_MAIL_STARTTLS_ENABLE=true

