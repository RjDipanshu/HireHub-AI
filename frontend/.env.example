# Supabase Configuration
VITE_SUPABASE_URL=https://qbdcvnkomdzqfxevlhhj.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_public_key_here

# Frontend Application URL (used for auth redirect callbacks such as password reset and signup email verification)
# In local development: http://localhost:5173
# In production: https://yourdomain.com
VITE_APP_URL=http://localhost:5173

# Optional: Override exact auth redirect URLs if different from defaults
# VITE_RESET_PASSWORD_REDIRECT_URL=http://localhost:5173/reset-password
# VITE_AUTH_VERIFY_REDIRECT_URL=http://localhost:5173/verify-email

# IMPORTANT: Configure Supabase Dashboard URL Configuration:
# Navigate to: Supabase Dashboard -> Project -> Authentication -> URL Configuration
# 1. Site URL: http://localhost:5173 (or your production URL)
# 2. Redirect URLs (Add all):
#    - http://localhost:5173/reset-password
#    - http://localhost:5173/verify-email
#    - http://localhost:5173/auth/callback
#    - https://<your-production-domain>/reset-password
#    - https://<your-production-domain>/verify-email
#    - https://<your-production-domain>/auth/callback

# Backend API Configuration
VITE_API_BASE_URL=/api/v1
