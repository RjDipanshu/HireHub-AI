# ==============================================================================
# HIREHUB AI - FRONTEND PRODUCTION ENVIRONMENT VARIABLES
# ==============================================================================
# IMPORTANT:
# - These variables are embedded into the static bundle at build time.
# - DO NOT place any real secrets, service-role keys, or database passwords here.
# - Only place the Supabase *Publishable* URL and Anon Key here.
# - The API_BASE_URL must point to the production backend (or relative for Nginx reverse proxy).
# ==============================================================================

# Supabase Configuration (Public/Anon Only)
VITE_SUPABASE_URL=${VITE_SUPABASE_URL}
VITE_SUPABASE_ANON_KEY=${VITE_SUPABASE_ANON_KEY}

# Backend API Endpoint
# In production with Nginx, this usually points to the same domain's /api/ path.
VITE_API_BASE_URL=${VITE_API_BASE_URL:-/api/v1}
