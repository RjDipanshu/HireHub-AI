# =============================================================================
# HireHub AI — Docker Compose Environment Configuration Template
# Copy to .env in project root: cp .env.docker.example .env
# =============================================================================

# Frontend Supabase Client Configuration
VITE_SUPABASE_URL=https://qbdcvnkomdzqfxevlhhj.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Backend Database Credentials (Supabase PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://db.qbdcvnkomdzqfxevlhhj.supabase.co:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_database_password_here

# Backend Supabase Auth Verification
SUPABASE_JWT_ISSUER=https://qbdcvnkomdzqfxevlhhj.supabase.co/auth/v1
SUPABASE_JWK_SET_URI=https://qbdcvnkomdzqfxevlhhj.supabase.co/auth/v1/.well-known/jwks.json

# Gemini AI API Key (Required for Resume Analysis, Job Match, and Interview Prep)
GEMINI_API_KEY=your_google_gemini_api_key_here

# CORS Configuration for Production Domains
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173
